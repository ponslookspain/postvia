generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES_PRISMA_URL")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum Platform {
  X
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
}

enum PostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Plan {
  FREE
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum TestMode {
  BYPASS
  ENFORCEMENT
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  emailVerified  Boolean          @default(false)
  name           String
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          Post[]
  socialAccounts SocialAccount[]
  sessions       Session[]
  authAccounts   Account[]
  preferences    UserPreferences?
  media          Media[]
  subscription   Subscription?
  testOverride   BillingTestOverride?
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  productUpdates     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  stripeCustomerId   String?
  stripeSubId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Developer test state, strictly separated from the real Subscription.
 * Only ever consulted when the user passes the server-side admin gate;
 * ordinary flows never read this table.
 */
model BillingTestOverride {
  id                 String             @id @default(cuid())
  userId             String             @unique
  mode               TestMode
  plan               Plan               @default(GROWTH)
  subStatus          SubscriptionStatus @default(ACTIVE)
  cancelAtPeriodEnd  Boolean            @default(false)
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  text         String
  status       PostStatus   @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  scheduledAt  DateTime?
  publishedAt  DateTime?
  errorMessage String?
  user         User         @relation(fields: [userId], references: [id])
  targets      PostTarget[]
  media        Media[]

  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([status, updatedAt])
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  socialAccountId String?
  platform        Platform
  status          PostTargetStatus @default(PENDING)
  externalPostId  String?
  externalJobId   String?
  publishedAt     DateTime?
  errorMessage    String?
  overrides       Json?
  createdAt       DateTime         @default(now()) @db.Timestamp(3)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamp(3)
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([socialAccountId])
  @@index([externalJobId])
}

model Media {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  url       String
  pathname  String
  filename  String
  mimeType  String
  size      Int
  type      MediaType
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  // One stored object per pathname: concurrent upload-completed webhooks
  // for the same key collapse into a single row (P2002 = already registered).
  @@unique([pathname])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     Platform
  externalId   String
  username     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      PostTarget[]

  @@unique([userId, platform, externalId])
  @@unique([platform, externalId])
  @@index([userId, platform])
}
