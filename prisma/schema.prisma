generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES_PRISMA_URL")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum Platform {
  X
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
}

enum PostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Plan {
  FREE
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

enum TestMode {
  BYPASS
  ENFORCEMENT
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  emailVerified  Boolean          @default(false)
  name           String
  image          String?
  /**
   * Mobbin-style onboarding gate. False for every user created through the
   * OTP flow; backfilled to true for pre-existing verified users (incl. the
   * admin) so they never see onboarding. Server pages redirect to
   * /onboarding while false — never trust client state for this.
   */
  onboardingCompleted Boolean @default(false)
  /**
   * Authoritative server-side plan intent (replaces the client-only
   * localStorage ?plan= hint). Written by /api/onboarding and /api/billing
   * actions only; the Stripe Subscription row stays the single source of
   * truth for paid entitlements.
   */
  selectedPlan   Plan?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          Post[]
  socialAccounts SocialAccount[]
  sessions       Session[]
  authAccounts   Account[]
  preferences    UserPreferences?
  media          Media[]
  subscription   Subscription?
  testOverride   BillingTestOverride?
  postUsages     PostUsage[]
  identityLink   AbuseIdentityLink?
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  productUpdates     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  stripeCustomerId   String?
  stripeSubId        String?
  /**
   * Stripe `event.created` (unix seconds) of the last applied subscription
   * event. Out-of-order deliveries with an older timestamp are ignored, so
   * a stale event can never roll back newer plan/status state. Null means
   * no timestamped event has been applied yet (legacy rows, admin writes).
   */
  lastStripeEventCreated Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Developer test state, strictly separated from the real Subscription.
 * Only ever consulted when the user passes the server-side admin gate;
 * ordinary flows never read this table.
 */
model BillingTestOverride {
  id                 String             @id @default(cuid())
  userId             String             @unique
  mode               TestMode
  plan               Plan               @default(GROWTH)
  subStatus          SubscriptionStatus @default(ACTIVE)
  cancelAtPeriodEnd  Boolean            @default(false)
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Stripe webhook idempotency ledger. Every verified event id is claimed
 * before processing; a duplicate delivery (Stripe retries, concurrent
 * workers) hits the unique eventId and is acknowledged without re-applying.
 * Rows are never read for billing state — Subscription stays the single
 * source of truth.
 */
model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}

/**
 * Monthly post-creation ledger. One row per user per UTC calendar month
 * (period "YYYY-MM"). The counter only ever grows: deleting a post never
 * decrements it, so create/delete loops cannot refill the monthly quota.
 * Rows are created lazily on first claimed creation, backfilled from the
 * live post count — usage before that moment follows the same rules.
 */
model PostUsage {
  id        String   @id @default(cuid())
  userId    String
  period    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

enum AbuseRisk {
  LOW
  MEDIUM
  HIGH
  ABUSE
}

enum AbuseSignalKind {
  GOOGLE_SUB
  EMAIL_HASH
  SOCIAL_LINK
  DEVICE_COOKIE
  IP_HASH
}

enum AbuseEventKind {
  CREATED
  MERGED
  SIGNAL
  TOMBSTONE_HIT
  RISK
  LINK_DENY
  POST_DENY
}

/**
 * Minimal immutable-ish abuse audit trail. Best-effort telemetry only:
 * never blocks the hot path, never stores raw PII (counts and ids only).
 * The authoritative security state lives in AbuseIdentity/AbuseFreeUsage,
 * never here.
 */
model AbuseEvent {
  id         String         @id @default(cuid())
  identityId String?
  kind       AbuseEventKind
  createdAt  DateTime       @default(now())

  @@index([identityId])
  @@index([createdAt])
}

/**
 * Abuse identity: the unit Free value belongs to. One human may own several
 * Postvia users (AbuseIdentityLink), but the Free monthly allowance is
 * consumed once per identity per period — new accounts never mint fresh
 * Free quota. Paid subscriptions are NEVER pooled here: each Stripe
 * Subscription stays bound to its own user with its own limits.
 */
model AbuseIdentity {
  id             String              @id @default(cuid())
  riskLevel      AbuseRisk           @default(LOW)
  riskReason     String?
  lastLinkedAt   DateTime?
  firstSeenAt    DateTime            @default(now())
  lastSeenAt     DateTime            @updatedAt
  users          AbuseIdentityLink[]
  signals        AbuseSignal[]
  freeUsages     AbuseFreeUsage[]
}

/**
 * One Postvia user belongs to at most one abuse identity. The link is
 * removed by cascade when the user is deleted; the identity, its signals
 * and its consumed Free value survive (see AbuseTombstone).
 */
model AbuseIdentityLink {
  id         String        @id @default(cuid())
  identityId String
  userId     String        @unique
  createdAt  DateTime      @default(now())
  identity   AbuseIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/**
 * Stable identity signals. The global (kind, valueHash) unique key is the
 * matcher: a signal value can only ever point at one identity, which makes
 * concurrent resolves serialize through P2002 into a single identity.
 * Only hashes are stored — never raw emails, subs or external ids.
 */
model AbuseSignal {
  id            String           @id @default(cuid())
  identityId    String
  kind          AbuseSignalKind
  valueHash     String
  pepperVersion Int              @default(1)
  createdAt     DateTime         @default(now())
  identity      AbuseIdentity    @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([kind, valueHash])
  @@index([identityId])
}

/**
 * Survives User/SocialAccount deletion: re-registration with the same
 * email, Google sub or social account re-resolves the recorded identity
 * instead of minting fresh Free value. identityId is informational (no FK,
 * may dangle after merges — resolution falls back to a plain tombstone
 * hit). Swept after TTL.
 */
model AbuseTombstone {
  id          String           @id @default(cuid())
  kind        AbuseSignalKind
  valueHash   String
  identityId  String?
  deletedAt   DateTime         @default(now())

  @@unique([kind, valueHash])
  @@index([identityId])
  @@index([deletedAt])
}

/**
 * Identity-level Free ledger. One row per identity per UTC calendar month
 * (period "YYYY-MM"); the counter only grows. Created lazily on the first
 * Free claim, initialized to the SUM of the linked users' PostUsage ledger
 * counts (with the live post count as a legacy lower bound), so
 * already-consumed value is never re-granted. Claimed atomically with a
 * conditional increment — concurrent claims on the last unit grant exactly
 * one winner. Paid plans never touch this table.
 */
model AbuseFreeUsage {
  id         String        @id @default(cuid())
  identityId String
  period     String
  count      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  identity   AbuseIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, period])
  @@index([identityId])
}

/**
 * Persistent, multi-instance rate-limit ledger (replaces in-memory Maps
 * for abuse-relevant scopes). Rows are tiny and self-expiring via resetAt.
 */
model AbuseRateBucket {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, keyHash])
  @@index([resetAt])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  text         String
  status       PostStatus   @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  scheduledAt  DateTime?
  publishedAt  DateTime?
  errorMessage String?
  /**
   * Client-generated idempotency key for post creation (one user action =
   * one key). The composer mints a UUID per editing session, bulk mints one
   * per batch item; retries and double-submits reuse the same key so the
   * server collapses them into a single row (unique index + P2002 catch in
   * POST /api/posts). NULL for legacy rows; Postgres treats NULLs as
   * distinct, so no backfill is needed. NEVER derived from post content:
   * two genuinely identical posts are allowed with different keys.
   */
  clientOperationId String? @unique
  user         User         @relation(fields: [userId], references: [id])
  targets      PostTarget[]
  media        Media[]

  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([status, updatedAt])
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  socialAccountId String?
  platform        Platform
  status          PostTargetStatus @default(PENDING)
  externalPostId  String?
  externalJobId   String?
  publishedAt     DateTime?
  errorMessage    String?
  overrides       Json?
  createdAt       DateTime         @default(now()) @db.Timestamp(3)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamp(3)
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([socialAccountId])
  @@index([externalJobId])
}

model Media {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  url       String
  pathname  String
  filename  String
  mimeType  String
  size      Int
  type      MediaType
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  // One stored object per pathname: concurrent upload-completed webhooks
  // for the same key collapse into a single row (P2002 = already registered).
  @@unique([pathname])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     Platform
  externalId   String
  username     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      PostTarget[]

  @@unique([userId, platform, externalId])
  @@unique([platform, externalId])
  @@index([userId])
  @@index([userId, platform])
}
