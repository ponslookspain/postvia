generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Platform {
  X
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
}

enum PostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  posts     Post[]
  accounts  SocialAccount[]
}

model Post {
  id           String      @id @default(cuid())
  userId       String
  text         String
  status       PostStatus  @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scheduledAt  DateTime?
  publishedAt  DateTime?
  errorMessage String?
  user         User        @relation(fields: [userId], references: [id])
  targets      PostTarget[]
}

model PostTarget {
  id             String           @id @default(cuid())
  postId         String
  platform       Platform
  status         PostTargetStatus @default(PENDING)
  externalPostId String?
  publishedAt    DateTime?
  errorMessage   String?
  post           Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  platform     Platform
  externalId   String
  username     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@unique([platform, externalId])
}
