# PostVia environment template — names and safe placeholders only. Never commit real values.
# See docs/environment.md for required/optional and per-env guidance.
# Local social-dev quick start: see docs/local-social-dev.md.
#
# LOCAL (.env.local) values for real OAuth testing through the permanent
# ngrok development origin (placeholders only — never commit secrets):
#   BETTER_AUTH_URL=https://lavish-passion-dipped.ngrok-free.dev
#   BETTER_AUTH_TRUSTED_ORIGINS=https://lavish-passion-dipped.ngrok-free.dev
#   X_REDIRECT_URI=https://lavish-passion-dipped.ngrok-free.dev/api/auth/x/callback
#   THREADS_REDIRECT_URI=https://lavish-passion-dipped.ngrok-free.dev/api/auth/threads/callback
#   TIKTOK_REDIRECT_URI=https://lavish-passion-dipped.ngrok-free.dev/api/auth/tiktok/callback
#   INSTAGRAM_REDIRECT_URI=https://lavish-passion-dipped.ngrok-free.dev/api/auth/instagram/callback
# Production redirect URIs (https://postvia.online/...) stay in the Vercel
# Production env vars and provider portals — do NOT overwrite them with dev values.

DATABASE_URL_POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/db?sslmode=require
BETTER_AUTH_SECRET=change-me-32-chars-minimum

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

ABUSE_HASH_PEPPER=
ABUSE_ENFORCEMENT=observe

RESEND_API_KEY=
EMAIL_FROM=hello@postvia.online
EMAIL_REPLY_TO=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

CRON_SECRET=
BLOB_WEBHOOK_PUBLIC_KEY=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# CI-only sourcemap upload:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

BETTER_AUTH_URL=
# Local social-OAuth development only (never set in Vercel Preview/Production):
# permanent ngrok development origin in front of http://localhost:3000.
# See docs/local-social-dev.md. Example: BETTER_AUTH_TRUSTED_ORIGINS=https://lavish-passion-dipped.ngrok-free.dev
BETTER_AUTH_TRUSTED_ORIGINS=
OTP_E2E_DEBUG=
OTP_DEBUG_TOKEN=

THREADS_POLL_DELAY_MS=
THREADS_MAX_ATTEMPTS=
THREADS_TIMEOUT_MS=
THREADS_VIDEO_POLL_DELAY_MS=
THREADS_VIDEO_MAX_ATTEMPTS=
THREADS_VIDEO_TIMEOUT_MS=

# Local/test-only (never set in Vercel):
# DATABASE_URL=postgresql://localhost:5432/postvia
# ALLOW_TEST_CLEANUP=1
# PG_INTEGRATION=1
# E2E_BASE=http://localhost:3000
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
